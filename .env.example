# Local runs: copy to .env and `set -a; . ./.env; set +a`. Never commit .env.
PURPLEAIR_API_KEY=
AIRTABLE_TOKEN=
# Sensor Deployments base (Airtable URL, starts with "app"):
AIRTABLE_BASE_ID=
# Write to a local directory instead of S3 (dry run):
# AQ_STORE=/tmp/aq
# Or a scratch prefix in the real bucket (needs AWS_PROFILE=mco):
# AQ_PREFIX=air-quality-scratch
# Empty disables CloudFront invalidation:
CDN_DISTRIBUTION_ID=
